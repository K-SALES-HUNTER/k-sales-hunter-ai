{
  "$defs": {
    "ChatTurn": {
      "properties": {
        "role": {
          "title": "Role",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "role",
        "text"
      ],
      "title": "ChatTurn",
      "type": "object"
    },
    "CopilotPage": {
      "description": "AI 패널이 열린 화면. 어떤 컨텍스트를 붙일지 결정한다.",
      "enum": [
        "TOTAL_REPORT",
        "COUNTRY_REPORT",
        "SALES_INFO",
        "DETAIL_PAGE",
        "SALES_OPS"
      ],
      "title": "CopilotPage",
      "type": "string"
    },
    "MarketProfile": {
      "description": "셀러의 브랜드 설정. 시장 해설과 콘텐츠 톤에 반영된다 (MKT-01-03).",
      "properties": {
        "brandDirection": {
          "default": "",
          "title": "Branddirection",
          "type": "string"
        },
        "sellerType": {
          "default": "",
          "title": "Sellertype",
          "type": "string"
        },
        "mainTarget": {
          "default": "",
          "title": "Maintarget",
          "type": "string"
        },
        "brandTone": {
          "default": "",
          "title": "Brandtone",
          "type": "string"
        }
      },
      "title": "MarketProfile",
      "type": "object"
    },
    "Packaging": {
      "description": "포장 완료 기준 치수. 배송 요율 구간을 결정한다 (R-004-10).",
      "properties": {
        "weightG": {
          "title": "Weightg",
          "type": "integer"
        },
        "widthMm": {
          "title": "Widthmm",
          "type": "integer"
        },
        "depthMm": {
          "title": "Depthmm",
          "type": "integer"
        },
        "heightMm": {
          "title": "Heightmm",
          "type": "integer"
        }
      },
      "required": [
        "weightG",
        "widthMm",
        "depthMm",
        "heightMm"
      ],
      "title": "Packaging",
      "type": "object"
    },
    "ProductSnapshot": {
      "description": "Spring 이 보내는 상품 스냅샷. Python 은 업무 DB 를 읽지 않는다.",
      "properties": {
        "productId": {
          "title": "Productid",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "supplyCostKrw": {
          "title": "Supplycostkrw",
          "type": "integer"
        },
        "weightG": {
          "title": "Weightg",
          "type": "integer"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "sellingPoint": {
          "default": "",
          "title": "Sellingpoint",
          "type": "string"
        },
        "mainTarget": {
          "default": "",
          "title": "Maintarget",
          "type": "string"
        },
        "packaging": {
          "anyOf": [
            {
              "$ref": "#/$defs/Packaging"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "imageUrls": {
          "items": {
            "type": "string"
          },
          "title": "Imageurls",
          "type": "array"
        }
      },
      "required": [
        "productId",
        "name",
        "category",
        "supplyCostKrw",
        "weightG"
      ],
      "title": "ProductSnapshot",
      "type": "object"
    }
  },
  "properties": {
    "message": {
      "title": "Message",
      "type": "string"
    },
    "page": {
      "$ref": "#/$defs/CopilotPage",
      "default": "TOTAL_REPORT"
    },
    "countryCode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Countrycode"
    },
    "context": {
      "additionalProperties": true,
      "title": "Context",
      "type": "object"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/ChatTurn"
      },
      "title": "History",
      "type": "array"
    },
    "product": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProductSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "marketProfile": {
      "anyOf": [
        {
          "$ref": "#/$defs/MarketProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "message"
  ],
  "title": "CopilotRequest",
  "type": "object"
}
