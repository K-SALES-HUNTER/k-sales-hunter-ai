# 복사해서 .env 로 쓴다.  cp .env.example .env
# .env 는 커밋하지 않는다. 키가 늘면 이 파일에 "이름만" 추가한다.

APP_ENV=local
LOG_LEVEL=INFO

# ── 인프라 ───────────────────────────────────────────────
POSTGRES_URL=postgresql+psycopg://ai_service:ai_service_pw@localhost:5432/sales_hunter
REDIS_URL=redis://localhost:6379/0

# ── LLM ─────────────────────────────────────────────────
# LLM_PROVIDER=fake 면 OPENAI_API_KEY 없이도 전 구간이 돌아간다 (tests/fixtures/llm 사용)
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=gpt-4o
OPENAI_MODEL_LIGHT=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1

# ── 외부 데이터 ──────────────────────────────────────────
# MARKET_PROVIDER=mock | tavily
MARKET_PROVIDER=mock
TAVILY_API_KEY=
# FX_PROVIDER=mock | exchangerate
FX_PROVIDER=mock
EXCHANGE_RATE_API_KEY=

# ── 내부 통신 ────────────────────────────────────────────
# Spring 과 공유하는 시크릿. 운영에서는 반드시 바꾼다.
INTERNAL_TOKEN=dev-internal-token
SPRING_BASE_URL=http://localhost:8080

# ── dev_bff (Spring 완성 전 임시 백엔드) ─────────────────
DEV_BFF_ENABLED=true
DEV_BFF_UPLOAD_DIR=./uploads

# ── 한도 ────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_SEC=480
NODE_TIMEOUT_SEC=90
LLM_TIMEOUT_SEC=60
DAILY_TOKEN_BUDGET=2000000
DAILY_IMAGE_BUDGET=50
